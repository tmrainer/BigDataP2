# ===== Copiar a .env y completar. NUNCA subir .env a GitHub. =====

# --- MongoDB Atlas (Free, creado en mongodb.com -> región Google Cloud us-central1) ---
# Atlas -> Connect -> Drivers -> Python. Agregar la IP externa de la VM al "IP Access List".
MONGO_URI=mongodb+srv://USUARIO:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=github_events

# --- Neo4j AuraDB (Free, creado en console.neo4j.io) ---
# Datos del archivo de credenciales que se descarga al crear la instancia.
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=CAMBIAR
NEO4J_DATABASE=neo4j

# --- Cassandra (local en la VM, contenedor "cassandra") ---
CASSANDRA_HOST=cassandra
CASSANDRA_KEYSPACE=github_metrics

# --- Pipeline ---
# Máximo de eventos a cargar por corrida horaria. Una hora de GH Archive trae 100k-300k eventos;
# Atlas Free tiene 0.5 GB, así que se recorta el documento y se limita la cantidad.
MAX_EVENTS_PER_RUN=60000
# Horas de retraso respecto a "ahora" para pedir el archivo (GH Archive publica con ~1-2 h de demora)
GHARCHIVE_LAG_HOURS=2

# --- Airflow / Jupyter ---
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_UID=50000
JUPYTER_TOKEN=bigdata
