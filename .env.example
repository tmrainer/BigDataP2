# ===== Copiar a .env. Valores por defecto funcionan tal cual (todo corre en Docker). =====
# Dentro de Docker, docker-compose.yml sobreescribe las URIs con los nombres de servicio
# (mongo, cassandra, neo4j). Los valores "localhost" de aquí sirven para conectarse desde
# el host (laptop con túnel SSH, o scripts corridos fuera de Docker).

# --- MongoDB (contenedor "mongo", sin autenticación: solo escucha en 127.0.0.1) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=github_events

# --- Cassandra (contenedor "cassandra") ---
CASSANDRA_HOST=localhost
CASSANDRA_KEYSPACE=github_metrics

# --- Neo4j (contenedor "neo4j"). La contraseña se aplica al crear el volumen por primera vez;
#     mínimo 8 caracteres. Para cambiarla después: docker compose down -v (borra datos). ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=bigdata2026
NEO4J_DATABASE=neo4j

# --- Pipeline ---
# Tope de eventos por corrida horaria (una hora de GH Archive trae ~4k eventos en 2026; 100k+ en 2025).
MAX_EVENTS_PER_RUN=60000
# Horas de retraso respecto a "ahora" para pedir el archivo (GH Archive publica con ~1-2 h de demora)
GHARCHIVE_LAG_HOURS=2

# --- Control de crecimiento (opcional; con BDs locales no hay límites de tier, por eso 0) ---
# >0: tras cada carga se borran de MongoDB los documentos con created_at anterior a (hora - N h).
MONGO_RETENTION_HOURS=0
# >0: tras cada carga se podan del grafo los usuarios sin actividad en las últimas N h.
NEO4J_RETENTION_HOURS=0
# Repos/usuarios más activos de cada lote que entran al grafo (acota el tamaño del grafo)
NEO4J_TOP_REPOS=10000
NEO4J_TOP_USERS=20000

# --- Airflow / Jupyter ---
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_UID=50000
JUPYTER_TOKEN=bigdata
