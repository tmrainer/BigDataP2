# copiar a .env; los valores por defecto funcionan con docker
# dentro de docker las uris se sobreescriben en docker-compose.yml

# --- mongodb
MONGO_URI=mongodb://localhost:27017
MONGO_DB=github_events

# --- cassandra
CASSANDRA_HOST=localhost
CASSANDRA_KEYSPACE=github_metrics

# --- neo4j (password minimo 8 caracteres, se fija al crear el volumen)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=bigdata2026
NEO4J_DATABASE=neo4j

# --- pipeline
# tope de eventos por corrida horaria (200000 = sin recorte)
MAX_EVENTS_PER_RUN=200000
# horas de retraso para pedir el archivo a gh archive
GHARCHIVE_LAG_HOURS=2
# horas faltantes: ventana a revisar y maximo por corrida (0 = no revisar)
RECOVERY_WINDOW_HOURS=72
RECOVERY_MAX_HOURS=6
# rango de la carga historica (scripts/backfill_days.py); END vacio = hoy
BACKFILL_START_DATE=2026-10-01
BACKFILL_END_DATE=

# --- control de crecimiento (opcional, 0 = desactivado)
# retencion de documentos en mongodb, en horas
MONGO_RETENTION_HOURS=0
# poda de usuarios inactivos del grafo, en horas
NEO4J_RETENTION_HOURS=0
# tope de repos y usuarios por lote que entran al grafo
NEO4J_TOP_REPOS=10000
NEO4J_TOP_USERS=20000

# --- airflow / jupyter
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_UID=50000
JUPYTER_TOKEN=bigdata
